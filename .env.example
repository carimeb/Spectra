# Spectra — variáveis de ambiente (copie para .env e preencha)
# NUNCA commitar o .env com valores reais.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=spectra

# --- LLM (chat/geração) via AI gateway ---
# Endpoint do seu gateway de IA ou da API Anthropic (protocolo Anthropic Messages API).
# Pode vir com ou sem o sufixo /v1: o cliente acrescenta /v1/... sozinho e um /v1
# duplicado é removido automaticamente.
LLM_BASE_URL=
# Token emitido pelo gateway (ou sua API key Anthropic) — nunca uma chave direta de provedor em ambiente corporativo.
LLM_API_KEY=
# id do modelo Claude exposto pelo endpoint.
LLM_MODEL=
# "anthropic" (default) ou "openai" — protocolo que o endpoint de chat expõe.
# A troca acontece somente dentro de get_chat_model(); o resto do código não conhece o provedor.
LLM_PROTOCOL=anthropic

# --- Embeddings (opcional) ---
# Sem EMBEDDINGS_API_KEY a busca vetorial é desativada e a busca híbrida degrada
# graciosamente para full-text apenas (log de aviso, nunca erro).
EMBEDDINGS_API_KEY=
# Endpoint do serviço de embeddings; vazio = endpoint padrão do provedor.
EMBEDDINGS_BASE_URL=
# "voyage" (default) ou "openai" — protocolo que o endpoint de embeddings expõe.
EMBEDDINGS_PROTOCOL=voyage
# id do modelo no serviço de embeddings (catálogos internos podem usar outro nome).
EMBEDDINGS_MODEL=voyage-3-lite
